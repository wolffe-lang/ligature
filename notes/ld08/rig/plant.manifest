# notes/ld08/rig/plant.manifest: the plant's take. The recorder runs it from a clean checkout of
# the plant branch (one commit, one hunk, on the green head) with this rig from the head's
# checkout: the planted break must fail the memory rows by name.
floor 35
rig lib.sh committed=../../..:HEAD:notes/ld08/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/ld08/rig/plant.manifest
step fetch-toolchain image=localhost/ld08-oracle:1 tools=python3 script=step.sh -- fetch-toolchain
step fetch-bundle needs=fetch-toolchain image=localhost/ld08-oracle:1 tools=python3 script=step.sh -- fetch-bundle
step trunk-build needs=fetch-toolchain image=localhost/ld08-oracle:1 tools=bash,sha256sum,taskset script=step.sh -- trunk-build
step build needs=fetch-bundle image=localhost/ld08-oracle:1 tools=bash,sha256sum script=step.sh -- build
step link-memory needs=build,trunk-build image=localhost/ld08-oracle:1 tools=python3,as script=step.sh -- link-memory
