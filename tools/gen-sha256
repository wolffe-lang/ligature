#!/usr/bin/env python3
"""Write src/sha256/sha256.lu: SHA-256 from FIPS 180-4 (August 2015), section 6.2.

The compression function is unrolled: the 64 round constants (section 4.2.2) are literals, the
message schedule (6.2.2 step 1) lives in sixteen rolling locals, and the working variables are
renamed from round to round instead of shuffled (step 3). Nothing allocates per block. The
generated file is checked in; tests/sha256-source.py regenerates it and compares.
usage: tools/gen-sha256 [--check]
"""
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
TARGET = ROOT / 'src/sha256/sha256.lu'
# FIPS 180-4 section 4.2.2: the first 32 bits of the fractional parts of the cube roots of the
# first sixty-four primes.
K = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
     0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
     0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
     0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
     0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
     0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
     0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
     0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
# Section 5.3.3: the initial hash value.
H0 = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]

HEAD = '''//! member: true

// Generated by tools/gen-sha256 from FIPS 180-4 section 6.2; regenerate it, never edit it by hand.

/// A running SHA-256 (FIPS 180-4 section 6.2): the eight hash words, a partial block and the
/// byte count. Absorbing allocates nothing, so a digest's working set is this state alone.
pub struct State { h: List[wrapping[u32]], block: List[byte], filled: int, total: int }

/// A fresh state holding the initial hash value (section 5.3.3).
pub fn start() -> State {
    let iv: List[int] = [
%s
    ]
    var h = List[wrapping[u32]]()
    (mut h).reserve(8)
    for v in iv { (mut h).push(v as wrapping[u32]) }
    var block = List[byte]()
    (mut block).reserve(64)
    for _ in 0..64 { (mut block).push(0 as byte) }
    State { h: h, block: block, filled: 0, total: 0 }
}

/// Absorb data[from..to]: whole blocks straight from data, the rest through the partial block.
pub fn absorb(mut st: State, data: List[byte], from: int, to: int) {
    var at = from
    st.total += to - from
    if st.filled > 0 {
        while st.filled < 64 && at < to {
            st.block[st.filled] = data[at]
            st.filled += 1
            at += 1
        }
        if st.filled < 64 { return }
        compress(mut st.h, st.block, 0)
        st.filled = 0
    }
    while to - at >= 64 {
        compress(mut st.h, data, at)
        at += 64
    }
    while at < to {
        st.block[st.filled] = data[at]
        st.filled += 1
        at += 1
    }
}

/// Pad (section 5.1.1), absorb the length and answer the 32-byte digest, big-endian (3.1).
pub fn finish(mut st: State) -> List[byte] {
    let bits = st.total * 8
    st.block[st.filled] = 128 as byte
    st.filled += 1
    if st.filled > 56 {
        while st.filled < 64 { st.block[st.filled] = 0 as byte; st.filled += 1 }
        compress(mut st.h, st.block, 0)
        st.filled = 0
    }
    while st.filled < 56 { st.block[st.filled] = 0 as byte; st.filled += 1 }
    for i in 0..8 { st.block[56 + i] = (bits >> 56 - 8 * i & 255) as byte }
    compress(mut st.h, st.block, 0)
    st.filled = 0
    var out = List[byte]()
    (mut out).reserve(32)
    for v in st.h {
        let x = v as int
        (mut out).push((x >> 24 & 255) as byte)
        (mut out).push((x >> 16 & 255) as byte)
        (mut out).push((x >> 8 & 255) as byte)
        (mut out).push((x & 255) as byte)
    }
    out
}

/// The SHA-256 of data, in one call.
pub fn of(data: List[byte]) -> List[byte] {
    var st = start()
    absorb(mut st, data, 0, data.len)
    finish(mut st)
}
'''


def compress():
    out = []
    o = out.append
    o('')
    o('// One 64-byte block at data[at..at + 64] (section 6.2.2), unrolled: K as literals, the')
    o('// schedule in sixteen rolling words, the working variables renamed each round.')
    o('fn compress(mut state: List[wrapping[u32]], data: List[byte], at: int) {')
    for t in range(16):
        b = [f'data[at + {4 * t + i}] as int as wrapping[u32]' for i in range(4)]
        o(f'    var w{t} = {b[0]} << 24 |')
        o(f'        {b[1]} << 16 |')
        o(f'        {b[2]} << 8 |')
        o(f'        {b[3]}')
    names = list('abcdefgh')
    for i, n in enumerate(names):
        o(f'    var {n} = state[{i}]')
    for t in range(64):
        a, b, c, d, e, f, g, h = [names[(i - t) % 8] for i in range(8)]
        w = f'w{t % 16}'
        if t >= 16:
            x, y, z = f'w{(t + 1) % 16}', f'w{(t + 14) % 16}', f'w{(t + 9) % 16}'
            # (6.2.2 step 1) W_t = sigma1(W_t-2) + W_t-7 + sigma0(W_t-15) + W_t-16
            o(f'    {w} = {w} +')
            o(f'        (({x} >> 7 | {x} << 25) ^ ({x} >> 18 | {x} << 14) ^ {x} >> 3) +')
            o(f'        {z} +')
            o(f'        (({y} >> 17 | {y} << 15) ^ ({y} >> 19 | {y} << 13) ^ {y} >> 10)')
        # (step 3) T1 = h + Sigma1(e) + Ch(e, f, g) + K_t + W_t; T2 = Sigma0(a) + Maj(a, b, c)
        o(f'    let t{t} = {h} +')
        o(f'        (({e} >> 6 | {e} << 26) ^ ({e} >> 11 | {e} << 21) ^ ({e} >> 25 | {e} << 7)) +')
        o(f'        ({e} & {f} ^ ({e} ^ 0xffffffff) & {g}) +')
        o(f'        {hex(K[t])} +')
        o(f'        {w}')
        o(f'    {d} = {d} + t{t}')
        o(f'    {h} = t{t} +')
        o(f'        (({a} >> 2 | {a} << 30) ^ ({a} >> 13 | {a} << 19) ^ ({a} >> 22 | {a} << 10)) +')
        o(f'        ({a} & {b} ^ {a} & {c} ^ {b} & {c})')
    # (step 4) the intermediate hash value
    for i, n in enumerate(names):
        o(f'    state[{i}] = state[{i}] + {n}')
    o('}')
    return '\n'.join(out) + '\n'


def source():
    return HEAD % '\n'.join(f'        {hex(v)},' for v in H0) + compress()


if __name__ == '__main__':
    text = source()
    if sys.argv[1:] == ['--check']:
        if TARGET.read_text() != text:
            print('FAIL sha256-source: src/sha256/sha256.lu differs from tools/gen-sha256', flush=True)
            sys.exit(1)
        print('PASS sha256-source: src/sha256/sha256.lu is tools/gen-sha256\'s output', flush=True)
        sys.exit(0)
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    TARGET.write_text(text)
