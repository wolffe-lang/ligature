#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
    --require-licensed-bundle) export LIGATURE_REQUIRE_SELF_LINK=1 ;;
    '') ;;
    *) echo 'usage: tools/check [--require-licensed-bundle]' >&2; exit 2 ;;
esac
tools/check-core
python3 -I tests/real-ligature.py
# Historical local replay may still diagnose the exact old runtime; CI may not.
python3 -I tests/self-link.py
python3 -I tests/link-cost.py
# Links of the musl runtime in a bounded footprint: hello, str and verify under 192 MiB resident
# and the linker's own link under 256 MiB, under a 512 MiB address-space cap, and N/10N/100N
# synthetic archives linear in memory and time.
python3 -I tests/link-memory.py
