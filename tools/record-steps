#!/usr/bin/env python3
"""Print the complete local gate command inventory as JSON, without running it.

A record runner consumes this plan at the same committed head. Candidate builds
are mandatory here; the hosted gate runs only their offline self-tests.
"""
import json
from pathlib import Path
import shlex
import sys

ROOT = Path(__file__).resolve().parents[1]
steps = []


def add(argv):
    if argv[0] == '.wolf-bin/wolf':
        name = 'wolf-' + argv[1]
    elif argv[0] == 'python3':
        name = Path(argv[2]).stem
        if argv[2] == 'tests/candidate-wolf.py':
            name = 'candidate-self-tests'
    else:
        name = Path(argv[0]).name.removeprefix('check-')
    if argv[0] == 'tools/check-candidate-wolf':
        name = 'candidate-wolf'
    if any(s['name'] == name for s in steps):
        # check-version has two distinct command lines.
        name += '-' + str(sum(s['name'].startswith(name) for s in steps) + 1)
    steps.append(dict(name=name, argv=argv))


for filename in ('tools/check-core', 'tools/check'):
    lines = (ROOT / filename).read_text().splitlines()
    for line in lines:
        if line.startswith('python3 -I ') or line.startswith('tools/'):
            if line == 'tools/check-core':
                continue
            add(shlex.split(line))
        elif line.startswith('"$wolf" '):
            add(['.wolf-bin/wolf', *shlex.split(line)[1:]])
        elif filename.endswith('check-core') and line and not line.startswith(('#', 'set ', 'cd ', 'export ', 'wolf=')):
            raise SystemExit(f'FAIL record-steps-unplanned-command: {filename}: {line}')
add(['tools/check-candidate-wolf'])
print(json.dumps(steps, indent=2))
