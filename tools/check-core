#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export WOLF_STD=${WOLF_STD:-$PWD/.wolf-bin/std}
wolf=${WOLF:-$PWD/.wolf-bin/wolf}
"$wolf" fmt --check src
"$wolf" test --deny-warnings --json src
# Native IO and malformed-file rows cannot be replaced by checked unit tests.
tools/build
python3 -I tests/fetch-bundle.py
python3 -I tests/self-link-blocker.py
python3 -I tests/integration.py
python3 -I tests/oracle.py
python3 -I tests/resolution.py
python3 -I tests/resolve.py
python3 -I tests/lazy-order.py
python3 -I tests/writer.py
python3 -I tests/relocation-witness.py
python3 -I tests/cc.py
python3 -I tests/provenance.py
python3 -I tests/attribution.py
python3 -I tests/pax-validator.py
python3 -I tests/static-pax-runner.py
python3 -I tests/kernel-edge.py
# Read the public runtime too; it is glibc-targeted, not the PAX runtime.
if [ -n "${WOLF_RT_FOR_TEST:-}" ]; then
    target/ligature roundtrip "$WOLF_RT_FOR_TEST"
elif [ -f .wolf-bin/libwolf_rt.a ]; then
    target/ligature roundtrip .wolf-bin/libwolf_rt.a
else
    echo 'SKIP public-runtime roundtrip: set WOLF_RT_FOR_TEST or stage .wolf-bin' >&2
    exit 1
fi
