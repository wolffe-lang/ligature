//! member: false

// signal.lu — a signal row (px57): /usr/share/lupin/signal.lu. What a
// meaning is numbered on this host, then its words: lupin, which admits
// no `unsafe` and links no libc, has no `strsignal` to read them with,
// so it refuses `os_signal_text` by name and the run ends there
// (`unsupported`, exit 4): the row a reader meets on any host lupin runs.
fn main() -> !int {
    let n = os_signal_number(16) else |e| {
        let t = match e {
            invalid => "invalid",
            unsupported => "unsupported",
        }
        print("INTERRUPT's number: {t}")
        return 1
    }
    print("INTERRUPT is signal {n} here")
    let t = os_signal_text(16) else |e| {
        let w = match e {
            invalid => "invalid",
            unsupported => "unsupported",
        }
        print("INTERRUPT's words: {w}")
        return 1
    }
    print("its words: {t}")
    0
}
