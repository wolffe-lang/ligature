//! member: false

// host.lu — the clock, the environment and the tree (px57):
// /usr/share/lupin/host.lu, for `lupin conform-run --json`: the record
// says what lupin's machine answers on the host it runs on. The clock
// is a duration, never a time; the environment is the machine's own
// overlay (lupin never reads the host's, so a program sees the same
// answers on every host: HOME is missing until the program sets it);
// the tree is the host's, served inside the working directory and
// refused by name outside it (`[os.fs.path.domain]`: from `/`, root's
// home, /usr/share/lupin is inside; from /home/pax it is not), its
// names sorted (a directory's order is its file system's).
/// Each name, smallest first, by selection over the list (no std: the
/// image carries no std tree, and `List.insert` is std.list's).
fn print_sorted(dir: str, xs: List[str]) {
    var last = ""
    var first = true
    var k = 0
    while k < xs.len {
        var best = ""
        var have = false
        for x in xs {
            if (first || x > last) && (have == false || x < best) {
                best = x
                have = true
            }
        }
        print("tree: {dir}/{best}")
        last = best
        first = false
        k = k + 1
    }
}

fn home() -> str {
    let h = env_get("HOME") else |e| {
        return match e {
            invalid => "invalid",
            missing => "missing",
        }
    }
    h
}

fn main() -> !int {
    let t0 = time_now_ms()
    time_sleep_ms(20)
    let t1 = time_now_ms()
    print("clock: a 20 ms sleep, at least 20 ms passed: {t1 - t0 >= 20}")
    print("env: HOME before the program sets it: {home()}")
    env_set("HOME", "/home/wolf")?
    print("env: HOME after env_set: {home()}")
    let st = fs_stat("x.lu")?
    print("tree: x.lu in the working directory: kind {st[0]}, {st[1]} bytes")
    let names = fs_read_dir("/usr/share/lupin")?
    print_sorted("/usr/share/lupin", names)
    0
}
