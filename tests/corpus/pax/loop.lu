//! member: false

// loop.lu — a loop (px57): /usr/share/lupin/loop.lu. The squares of one
// to ten, and their sum.
fn main() -> !int {
    var sum = 0
    var i = 1
    while i <= 10 {
        let sq = i * i
        print("{i} squared is {sq}")
        sum = sum + sq
        i = i + 1
    }
    print("the sum of the squares: {sum}")
    0
}
