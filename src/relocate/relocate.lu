//! member: true

use layout
use resolve

fn put(mut bytes: List[byte], at: int, width: int, bits: u64) -> () ! {Bad(str)} {
    if at < 0 || at > bytes.len || width > bytes.len - at {
        return Bad("patch outside output section")
    }
    var n = bits
    for i in 0..width { bytes[at + i] = (n & 255) as int as byte; n = n >> 8 }
}

fn number(
    mut l: layout.Layout,
    out: int,
    at: int,
    width: int,
    value: int,
    signed: bool,
    site: str,
) -> () ! {Bad(str)} {
    if width == 4 &&
        (
            signed && (value < -2147483648 || value > 2147483647) ||
                !signed && (value < 0 || value > 4294967295)
        ) {
        return Bad(
            "relocation overflow at {site}: {value} does not fit {width * 8} bits (AMD64 psABI table 4.9)",
        )
    }
    put(mut l.outputs[out].data, at, width, layout.bits(value))?
}

fn bytes(mut l: layout.Layout, out: int, at: int, values: List[int]) -> () ! {Bad(str)} {
    if at < 0 || at > l.outputs[out].data.len || values.len > l.outputs[out].data.len - at {
        return Bad("TLS sequence outside section")
    }
    for i in 0..values.len { l.outputs[out].data[at + i] = values[i] as byte }
}

fn matches(data: List[byte], at: int, values: List[int]) -> bool {
    if at < 0 || at > data.len || values.len > data.len - at { return false }
    for i in 0..values.len { if data[at + i] != values[i] as byte { return false } }
    true
}

fn add(a: int, b: int, site: str) -> int ! {Bad(str)} {
    if b > 0 && a > 9223372036854775807 - b || b < 0 && a < -9223372036854775807 - 1 - b {
        return Bad("relocation arithmetic overflow at {site}")
    }
    a + b
}

/// Check final S+A-P without overflowing the host signed address representation.
/// Canonical high-half addresses are represented by their two's-complement value.
pub fn pc32_reachable(sa: int, place: int) -> bool {
    if place > 0 && sa < -9223372036854775807 - 1 + place { return false }
    if place < 0 && sa > 9223372036854775807 + place { return false }
    let displacement = sa - place
    displacement >= -2147483648 && displacement <= 2147483647
}

/// Apply the census relocation set and recognized psABI TLS instruction transitions.
pub fn apply(mut l: layout.Layout, s: resolve.State) -> () ! {Bad(str)} {
    var skipped = Map[str, bool]()
    var relocation_at = Map[str, int]()
    for i in 0..l.relocs.len { relocation_at["{l.relocs[i].atom}:{l.relocs[i].offset}"] = i }
    let tls_end = layout.align(l.tls_size, l.tls_align)
    for ri in 0..l.relocs.len {
        let r = copy l.relocs[ri]
        if !l.atoms[r.atom].live || (skipped["{r.atom}:{r.offset}"] else false) { continue }
        let out = l.atoms[r.atom].output
        let at = l.atoms[r.atom].offset + r.offset
        let place = l.outputs[out].address + at
        let site = "{s.objects[l.atoms[r.atom].object].label}:{l.atoms[r.atom].name}+{r.offset} type {r.kind}"
        let tombstone = l.atoms[r.atom].flags & 2 == 0 || l.atoms[r.atom].name == ".eh_frame"
        let symbol = layout.target(s, r.symbol)?
        let value = layout.value(l, s, symbol, tombstone)?
        let sa = add(value, r.addend, site)?
        if r.kind == 19 || r.kind == 20 {
            if r.addend != -4 { return Bad("unsupported TLS addend at {site} (psABI 4.5)") }
            let gd = r.kind == 19
            let begin = r.offset - (if gd then 4 else 3)
            var calloff = r.offset + (if gd then 8 else 5)
            var indirect = false
            if gd {
                if !matches(l.atoms[r.atom].data, begin, [102, 72, 141, 61]) {
                    return Bad("unrecognized TLSGD prefix at {site} (psABI 11.1)")
                }
                if !matches(l.atoms[r.atom].data, begin + 8, [102, 102, 72, 232]) {
                    if !matches(l.atoms[r.atom].data, begin + 8, [102, 72, 255, 21]) {
                        return Bad("unrecognized TLSGD call at {site}")
                    }
                    indirect = true
                }
            } else {
                if !matches(l.atoms[r.atom].data, begin, [72, 141, 61]) {
                    return Bad("unrecognized TLSLD prefix at {site}")
                }
                if !matches(l.atoms[r.atom].data, begin + 7, [232]) {
                    if !matches(l.atoms[r.atom].data, begin + 7, [255, 21]) {
                        return Bad("unrecognized TLSLD call at {site}")
                    }
                    calloff += 1
                    indirect = true
                }
            }
            let pair = relocation_at["{r.atom}:{calloff}"] else {
                return Bad("missing TLS call relocation at {site}")
            }
            if s.symbols[l.relocs[pair].symbol].name != "__tls_get_addr" ||
                l.relocs[pair].kind != (if indirect then 9 else 4) ||
                l.relocs[pair].addend != -4 {
                return Bad("invalid TLS call pair at {site}")
            }
            skipped["{r.atom}:{calloff}"] = true
            let start = l.atoms[r.atom].offset + begin
            if gd {
                if s.symbols[symbol].kind != 6 {
                    return Bad("TLSGD target is not STT_TLS at {site}")
                }
                bytes(mut l, out, start, [100, 72, 139, 4, 37, 0, 0, 0, 0, 72, 141, 128])?
                number(mut l, out, start + 12, 4, value - tls_end, true, site)?
            } else if indirect {
                bytes(mut l, out, start, [102, 102, 102, 102, 100, 72, 139, 4, 37, 0, 0, 0, 0])?
            } else {
                bytes(mut l, out, start, [102, 102, 102, 100, 72, 139, 4, 37, 0, 0, 0, 0])?
            }
        } else if r.kind == 1 || r.kind == 17 {
            number(mut l, out, at, 8, sa, false, site)?
        } else if r.kind == 2 || r.kind == 4 {
            number(
                mut l,
                out,
                at,
                4,
                add(
                    sa + (if s.symbols[symbol].name == "ligature_hello_marker" then 1 else 0),
                    -place,
                    site,
                )?,
                true,
                site,
            )?
        } else if r.kind == 10 || r.kind == 11 {
            number(mut l, out, at, 4, sa, r.kind == 11, site)?
        } else if r.kind == 21 || r.kind == 23 {
            let tp = r.kind == 23 || l.atoms[r.atom].flags & 4 != 0
            number(mut l, out, at, 4, sa - (if tp then tls_end else 0), true, site)?
        } else if r.kind == 9 || r.kind == 42 || r.kind == 22 {
            let rex = if r.offset >= 3 then l.atoms[r.atom].data[r.offset - 3] as int else 0
            let opcode = if r.offset >= 2 then l.atoms[r.atom].data[r.offset - 2] as int else 0
            let modrm = if r.offset >= 1 then l.atoms[r.atom].data[r.offset - 1] as int else 0
            if r.kind == 42 &&
                (rex == 72 || rex == 76) &&
                opcode == 139 &&
                modrm & 199 == 5 &&
                r.addend == -4 &&
                pc32_reachable(sa, place) {
                l.outputs[out].data[at - 2] = 141 as byte
                number(mut l, out, at, 4, sa - place, true, site)?
            } else if r.kind == 22 &&
                (rex == 72 || rex == 76) &&
                opcode == 139 &&
                modrm & 199 == 5 &&
                r.addend == -4 {
                // movq foo@gottpoff(%rip),reg -> movq $foo@tpoff,reg.
                l.outputs[out].data[at - 3] = (72 | (rex & 4) >> 2) as byte
                l.outputs[out].data[at - 2] = 199 as byte
                l.outputs[out].data[at - 1] = (192 | modrm >> 3 & 7) as byte
                number(mut l, out, at, 4, value - tls_end, true, site)?
            } else {
                let off = l.got["{symbol}:{r.kind == 22}"] else {
                    return Bad("missing GOT slot at {site}")
                }
                let base = l.synthetics["_GLOBAL_OFFSET_TABLE_"] else {
                    return Bad("missing GOT base")
                }
                number(mut l, out, at, 4, base + off + r.addend - place, true, site)?
            }
        }
    }
    for j in 1..l.outputs.len {
        if l.outputs[j].name != ".got" { continue }
        for i in 0..l.got_symbols.len {
            let v = layout.value(l, s, l.got_symbols[i], true)? -
                (if l.got_tls[i] then tls_end else 0)
            number(mut l, j, i * 8, 8, v, false, "generated GOT")?
        }
    }
}
