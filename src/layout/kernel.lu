//! member: true

use binary
use resolve

/// Add a bounded file/section extent to a full-width virtual address.
pub fn vadd(base: u64, extent: int) -> u64 ! {Bad(str)} {
    if extent < 0 || base > 18446744073709551615 - extent as u64 {
        return Bad("virtual address arithmetic overflow")
    }
    base + extent as u64
}

/// Names defined at the exact positions of the permitted script.
pub fn kernel_symbols() -> List[str] {
    [
        "__pax_image_start",
        "__pax_text_start",
        "__pax_text_end",
        "__pax_rodata_start",
        "__pax_rodata_end",
        "__pax_data_start",
        "__pax_image_end",
    ]
}

fn matches(name: str, prefix: str) -> bool { name == prefix || name.starts_with("{prefix}.") }

fn phase(name: str) -> int {
    if matches(name, ".text") { return 1 }
    if matches(name, ".rodata") { return 2 }
    if matches(name, ".data.rel.ro") { return 3 }
    if name == ".data.limine" { return 4 }
    if matches(name, ".data") { return 5 }
    if name == ".got" || name == ".got.plt" { return 6 }
    if matches(name, ".bss") { return 7 }
    0
}

fn reserve(mut l: Layout, out: int, size: int, alignment: int) -> int ! {Bad(str)} {
    if alignment > 4096 || size > 536870912 || l.outputs[out].size > 536870912 - size - 4096 {
        return Bad("kernel section size/alignment exceeds bounded layout")
    }
    let off = align(l.outputs[out].size, alignment)
    l.outputs[out].size = off + size
    if alignment > l.outputs[out].align { l.outputs[out].align = alignment }
    off
}

/// Place only the validated kernel profile, without signed virtual-address storage.
pub fn kernel_place(mut l: Layout, s: resolve.State) -> () ! {Bad(str)} {
    for name in kernel_symbols() {
        let _defined = s.globals[name] else { continue }
        return Bad("kernel script symbol conflicts with input definition {name}")
    }
    (mut l.outputs).push(output(".text", 1, 6, 1))
    (mut l.outputs).push(output(".rodata", 1, 2, 1))
    (mut l.outputs).push(output(".data", 1, 3, 8))
    (mut l.outputs).push(output(".bss", 8, 3, 1))
    for stage in 1..8 {
        for i in 1..l.atoms.len {
            if !l.atoms[i].live || phase(l.atoms[i].name) != stage { continue }
            let a = copy l.atoms[i]
            if a.flags & 2 == 0 ||
                a.flags & 1024 != 0 ||
                stage == 1 && a.flags & 5 != 4 ||
                stage != 1 && a.flags & 4 != 0 ||
                stage == 7 && a.kind != 8 ||
                stage != 7 && a.kind != 1 {
                return Bad("kernel section {a.name}: incompatible type/permissions")
            }
            let oi = if stage == 1 then 1 else if stage <= 3 then 2 else if stage <= 6 then 3 else 4
            l.atoms[i].offset = reserve(mut l, oi, a.size, a.align)?
            l.atoms[i].output = oi
        }
    }
    for i in 1..l.atoms.len {
        if !l.atoms[i].live || l.atoms[i].output != 0 { continue }
        let a = copy l.atoms[i]
        if a.flags & 2 != 0 { return Bad("kernel allocated orphan section {a.name}") }
        var oi = 0
        for j in 5..l.outputs.len {
            if l.outputs[j].name == a.name &&
                l.outputs[j].kind == a.kind &&
                l.outputs[j].flags == a.flags {
                oi = j
                break
            }
        }
        if oi == 0 {
            oi = l.outputs.len
            (mut l.outputs).push(output(a.name, a.kind, a.flags, a.align))
        }
        l.atoms[i].offset = reserve(mut l, oi, a.size, a.align)?
        l.atoms[i].output = oi
    }
    for i in 0..s.symbols.len {
        let sym = copy s.symbols[i]
        if sym.section != 65522 || (s.globals[sym.name] else -1) != i { continue }
        if !binary.pow2(sym.value) { return Bad("COMMON alignment is not a power of two") }
        l.common[i] = reserve(
            mut l,
            4,
            binary.bounded(sym.size, 536870912)?,
            binary.bounded(sym.value, 4096)?,
        )?
    }
    for r in l.relocs {
        if !l.atoms[r.atom].live || r.kind != 9 && r.kind != 42 { continue }
        let id = target(s, r.symbol)?
        let key = "{id}:false"
        let _old = l.got[key] else {
            l.got[key] = l.got_symbols.len * 8
            (mut l.got_symbols).push(id)
            (mut l.got_tls).push(false)
            continue
        }
    }
    l.got_output = 3
    l.got_offset = reserve(mut l, 3, l.got_symbols.len * 8, 8)?
    let base: u64 = 0xffffffff80000000
    var cursor: int = 4096
    for j in 1..5 {
        cursor = align(cursor, if j == 4 then l.outputs[j].align else 4096)
        l.outputs[j].fileoff = cursor
        l.outputs[j].address = vadd(base, cursor - 4096)?
        cursor += l.outputs[j].size
        if j == 3 { l.data_start = l.outputs[j].fileoff; l.data_file_end = cursor }
    }
    l.data_mem_end = align(cursor, 4096)
    l.text_end = align(l.outputs[1].fileoff + l.outputs[1].size, 4096)
    l.synthetics["__pax_image_start"] = base
    l.synthetics["__pax_text_start"] = base
    l.synthetics["__pax_text_end"] = vadd(base, l.text_end - 4096)?
    l.synthetics["__pax_rodata_start"] = vadd(base, l.text_end - 4096)?
    l.synthetics["__pax_rodata_end"] = l.outputs[3].address
    l.synthetics["__pax_data_start"] = l.outputs[3].address
    l.synthetics["__pax_image_end"] = vadd(base, l.data_mem_end - 4096)?
    l.synthetics["_GLOBAL_OFFSET_TABLE_"] = vadd(l.outputs[3].address, l.got_offset)?
    cursor = l.data_file_end
    for j in 5..l.outputs.len {
        cursor = align(cursor, l.outputs[j].align)
        l.outputs[j].fileoff = cursor
        cursor += l.outputs[j].size
    }
    for j in 1..l.outputs.len {
        if l.outputs[j].kind == 8 { continue }
        for _ in 0..l.outputs[j].size { (mut l.outputs[j].data).push(0 as byte) }
    }
    for a in l.atoms {
        if !a.live || a.kind == 8 { continue }
        for k in 0..a.data.len { l.outputs[a.output].data[a.offset + k] = a.data[k] }
    }
}
