//! member: false

use front
use census
use resolve
use writer
use explain
use script
use arwrite

fn execute(args: List[str]) -> () ! {Bad(str)} {
    if args.len == 1 && args[0] == "--version" {
        print("ligature 0.0.2 (static x86-64 ELF)")
        return
    }
    if args.len == 2 && (args[0] == "inspect" || args[0] == "verify" || args[0] == "roundtrip") {
        census.inspect(args[1], args[0])?
        return
    }
    if args.len > 0 && args[0] == "script-plan" {
        if args.len != 2 { return Bad("script-plan: usage: ligature script-plan FILE") }
        script.inspect(args[1])?
        return
    }
    if args.len > 0 && args[0] == "archive" {
        if args.len < 3 { return Bad("archive: usage: ligature archive OUTPUT OBJECT...") }
        arwrite.create(args[1], args[2..])?
        return
    }
    var plan = front.parse(args)?
    if plan.print_plan { front.emit(plan); return }
    if !plan.nostdlib {
        let root = env_get("LIGATURE_SYSROOT") else |e| match e {
            missing => "/usr/lib/wolf-musl",
            utf8 => { return Bad("LIGATURE_SYSROOT is not UTF-8") },
        }
        var unwind = false
        let size = fs_size("{root}/libunwind.a") else |_| -1
        if size >= 0 { unwind = true }
        front.musl(mut plan, root, unwind)?
    }
    if plan.resolve_only {
        var state = resolve.empty()
        defer resolve.finish(state)
        resolve.run(mut state, plan)?
        resolve.emit(state)
        return
    }
    var state = resolve.empty()
    defer resolve.finish(state)
    resolve.run(mut state, plan)?
    resolve.visibility(mut state)
    writer.link(state, plan)?
}

fn main() -> int {
    let args = env_args()
    if args.len > 0 && args[0] == "explain" { return explain.run(args) }
    execute(args) else |e| match e {
        Bad(message) => { eprint("ligature: {message}"); return 1 },
    }
    0
}
