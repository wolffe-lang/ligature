//! member: false

use front
use census

fn execute(args: List[str]) -> () ! {Bad(str)} {
    if args.len == 1 && args[0] == "--version" {
        print("ligature 0.0.1 (ELF map; linking not implemented)")
        return
    }
    if args.len == 2 && (args[0] == "inspect" || args[0] == "verify" || args[0] == "roundtrip") {
        census.inspect(args[1], args[0])?
        return
    }
    let plan = front.parse(args)?
    if plan.print_plan { front.emit(plan); return }
    for path in plan.inputs {
        let _size = fs_size(path) else |_| { continue }
        census.inspect(path, "link")?
    }
    Bad("linking not implemented; use --print-plan")
}

fn main() -> int {
    execute(env_args()) else |e| match e {
        Bad(message) => { eprint("ligature: {message}"); return 1 },
    }
    0
}
