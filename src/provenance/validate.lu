//! member: true

use binary
use elf
use std.json

/// A malformed manifest is a named input refusal, not a defaulted value.
pub fn field(v: json.Value, key: str) -> json.Value ! {Bad(str)} {
    json.get(v, key) else |_| { return Bad("provenance missing field {key}") }
}

/// Read an integer field, refusing missing or wrongly typed data.
pub fn integer(v: json.Value, key: str) -> int ! {Bad(str)} {
    json.as_int(field(v, key)?) else |_| { return Bad("provenance integer field {key}") }
}

/// Read a string field, refusing missing or wrongly typed data.
pub fn text(v: json.Value, key: str) -> str ! {Bad(str)} {
    json.as_str(field(v, key)?) else |_| { return Bad("provenance string field {key}") }
}

/// Read an array field, refusing missing or wrongly typed data.
pub fn array(v: json.Value, key: str) -> List[json.Value] ! {Bad(str)} {
    json.as_arr(field(v, key)?) else |_| { return Bad("provenance array field {key}") }
}

fn manifest_bytes(f: binary.Input, image: elf.Image) -> List[byte] ! {Bad(str)} {
    for sec in image.sections {
        if (str_from_utf8(elf.name(f, image, sec)?) else "") != ".wolf.link.manifest" { continue }
        return binary.read(f, sec.off, sec.size)
    }
    Bad("missing provenance manifest")
}

/// Read the embedded document. Call check first; parsing is not authentication.
pub fn document(f: binary.Input, image: elf.Image) -> json.Value ! {Bad(str)} {
    decode_document(manifest_bytes(f, image)?)
}

fn hex_digit(c: byte) -> int ! {Bad(str)} {
    let n = c as int
    if n >= 48 && n <= 57 { return n - 48 }
    if n >= 97 && n <= 102 { return n - 87 }
    Bad("invalid provenance hex bytes")
}

// The value of a lowercase hex digit, or -1.
fn hex_value(c: byte) -> int {
    let n = c as int
    if n >= 48 && n <= 57 { return n - 48 }
    if n >= 97 && n <= 102 { return n - 87 }
    -1
}

// One retained patch's recorded bytes against the file's, at bytes[at..at + width]: after's
// hex at pool[after..], before's at pool[before..]. Returns "" or the refusal, checking each
// byte's digits in patch_bytes' order.
fn patch_hex(
    bytes: List[byte],
    at: int,
    width: int,
    pool: List[byte],
    after: int,
    before: int,
) -> str {
    for i in 0..width {
        let hi = hex_value(pool[after + 2 * i])
        if hi < 0 { return "invalid provenance hex bytes" }
        let lo = hex_value(pool[after + 2 * i + 1])
        if lo < 0 { return "invalid provenance hex bytes" }
        if hi * 16 + lo != bytes[at + i] as int { return "provenance patch bytes differ" }
        if hex_value(pool[before + 2 * i]) < 0 { return "invalid provenance hex bytes" }
        if hex_value(pool[before + 2 * i + 1]) < 0 { return "invalid provenance hex bytes" }
    }
    ""
}

// One retained patch's recorded bytes against the file's, at bytes[at..at + width]. Returns ""
// or the refusal.
fn patch_bytes(bytes: List[byte], at: int, width: int, after: str, before: str) -> str {
    for i in 0..width {
        let hi = hex_digit(after.bytes()[2 * i]) else |_| { return "invalid provenance hex bytes" }
        let lo = hex_digit(after.bytes()[2 * i + 1]) else |_| {
            return "invalid provenance hex bytes"
        }
        if hi * 16 + lo != bytes[at + i] as int { return "provenance patch bytes differ" }
        let _hi = hex_digit(before.bytes()[2 * i]) else |_| {
            return "invalid provenance hex bytes"
        }
        let _lo = hex_digit(before.bytes()[2 * i + 1]) else |_| {
            return "invalid provenance hex bytes"
        }
    }
    ""
}

// A patch row's order, range and length checks, before its bytes. Returns "" or the refusal.
fn patch_row_shape(f: binary.Input, values: List[int], p: PatchCursor, previous_index: int) -> str {
    if values[5] <= previous_index { return "provenance patch index order or duplicate" }
    let start = values[10]
    let end = values[4]
    if start < 0 || end <= start || end > f.size { return "provenance patch range" }
    let after = p.lengths[values[1]]
    let before = p.lengths[values[2]]
    if after != 2 * (end - start) || before != after { return "provenance patch length" }
    ""
}

/// Digest validation precedes these semantic checks: signed garbage is still garbage.
/// The versioned patch table is validated in two streaming passes (format, then content), so no
/// row is ever materialized as JSON; the legacy JSON form is checked as one document.
pub fn validate(f: binary.Input, image: elf.Image) -> () ! {Bad(str)} {
    let raw = manifest_bytes(f, image)?
    if !is_table(raw) { return validate_document(f, image, decode_document(raw)?) }
    let (doc, opened) = patch_open(take raw, checked_keys())?
    var cursor = opened
    var values = patch_values()
    for _ in 0..cursor.rows { patch_next(mut cursor, mut values)? }
    patch_close(cursor)?
    if !validate_metadata(f, image, doc)? { return }
    if cursor.rows != retained_count(image) {
        return Bad("provenance retained patch count mismatch")
    }
    patch_rewind(mut cursor)
    var previous_index: int = -1
    var row: int = 0
    // A row decoded and checked but for its bytes, which wait for the next window.
    var pending = false
    while row < cursor.rows || pending {
        // The file's bytes are read a window at a time, each window in its own region; a row
        // outside the current window ends it. Every row passes the same checks, in the same
        // order, as a row read alone.
        let problem = copy region window {
            var message = ""
            var base: int = -1
            var bytes = List[byte]()
            loop {
                if !pending {
                    if row >= cursor.rows { break }
                    patch_next(mut cursor, mut values) else |e| match e {
                        Bad(m) => {
                            message = m
                            break
                        },
                    }
                    row += 1
                    message = patch_row_shape(f, values, cursor, previous_index)
                    if message.len != 0 { break }
                    pending = true
                }
                let start = values[10]
                let end = values[4]
                if base < 0 {
                    let want = if end - start > 16384 then end - start else 16384
                    let size = if want > f.size - start then f.size - start else want
                    bytes = binary.read(f, start, size) else |e| match e {
                        Bad(m) => {
                            message = m
                            break
                        },
                    }
                    base = start
                } else if start < base || end > base + bytes.len {
                    break
                }
                message = patch_hex(
                    bytes,
                    start - base,
                    end - start,
                    cursor.c.bytes,
                    cursor.starts[values[1]],
                    cursor.starts[values[2]],
                )
                if message.len != 0 { break }
                previous_index = values[5]
                pending = false
            }
            message
        }
        if problem.len != 0 { return Bad(problem) }
    }
}

fn retained_count(image: elf.Image) -> int {
    var retained: int = 0
    for sec in image.sections { if sec.kind == 4 { retained += sec.size / 24 } }
    retained
}

fn validate_document(f: binary.Input, image: elf.Image, doc: json.Value) -> () ! {Bad(str)} {
    if !validate_metadata(f, image, doc)? { return }
    let changes = array(doc, "patches")?
    if changes.len != retained_count(image) {
        return Bad("provenance retained patch count mismatch")
    }
    var previous_index: int = -1
    for p in changes {
        let index = integer(p, "index")?
        if index <= previous_index { return Bad("provenance patch index order or duplicate") }
        previous_index = index
        let start = integer(p, "start")?
        let end = integer(p, "end")?
        if start < 0 || end <= start || end > f.size { return Bad("provenance patch range") }
        let after = text(p, "after")?
        let before = text(p, "before")?
        if after.len != 2 * (end - start) || before.len != after.len {
            return Bad("provenance patch length")
        }
        let problem = copy region row {
            var message = ""
            let bytes = binary.read(f, start, end - start) else |e| match e {
                Bad(m) => {
                    message = m
                    List[byte]()
                },
            }
            if message.len == 0 { message = patch_bytes(bytes, 0, end - start, after, before) }
            message
        }
        if problem.len != 0 { return Bad(problem) }
    }
}

// The metadata members validate reads: patch_open builds only these.
fn checked_keys() -> List[str] {
    ["coverage", "format", "members", "output", "patches", "pulls", "ranges", "sections"]
}

// Everything but the patches: format, coverage, sections, byte ranges and extraction edges.
// False when the coverage is sections only, which has no patches to check.
fn validate_metadata(f: binary.Input, image: elf.Image, doc: json.Value) -> bool ! {Bad(str)} {
    if text(doc, "format")? != "wolf.link.provenance.v1" { return Bad("unknown provenance format") }
    let coverage = text(doc, "coverage")?
    if coverage == "sections" { return false }
    if coverage != "bytes-and-patches" { return Bad("unknown provenance coverage") }
    if integer(field(doc, "output")?, "bytes")? != f.size { return Bad("provenance output length") }
    for section in array(doc, "sections")? {
        let index = integer(section, "index")?
        if index <= 0 || index >= image.sections.len { return Bad("provenance section index") }
        let sec = copy image.sections[index]
        if sec.addr > 18446744073709551615 - sec.size as u64 {
            return Bad("provenance section virtual range overflows")
        }
        if address_field(section, "address")? != sec.addr ||
            address_field(section, "memory_end")? != sec.addr + sec.size as u64 {
            return Bad("provenance section address differs from ELF")
        }
    }
    let members = array(doc, "members")?
    let spans = array(doc, "ranges")?
    var cursor: int = 0
    for r in spans {
        let start = integer(r, "start")?
        let end = integer(r, "end")?
        if start != cursor || end <= start || end > f.size {
            return Bad("provenance gap, overlap or invalid range")
        }
        let member = integer(r, "member")?
        if text(r, "origin")? == "input" {
            if member < 0 || member >= members.len { return Bad("provenance range member") }
            let offset = integer(r, "input_offset")?
            let size = integer(members[member], "size")?
            if offset < 0 || offset > size || end - start > size - offset {
                return Bad("provenance input slice")
            }
        } else if member != -1 {
            return Bad("provenance generated range member")
        }
        cursor = end
    }
    if cursor != f.size { return Bad("provenance incomplete byte coverage") }
    let edges = array(doc, "pulls")?
    var selected = Map[int, bool]()
    for edge in edges {
        let object = integer(edge, "object")?
        let parent = integer(edge, "parent")?
        if object < 0 ||
            object >= members.len ||
            parent < -1 ||
            parent >= object ||
            (selected[object] else false) {
            return Bad("provenance invalid or cyclic extraction edge")
        }
        selected[object] = true
    }
    true
}

/// Decimal u64 text avoids JSON's lossy floating number tier above INT64_MAX.
pub fn address_json(value: u64) -> str {
    if value <= 9223372036854775807 { return "{value}" }
    "\"{value}\""
}

/// Parse a full-width address, retaining legacy nonnegative integer fields.
pub fn address_field(v: json.Value, key: str) -> u64 ! {Bad(str)} {
    let value = field(v, key)?
    let n = json.as_int(value) else |_| {
        let text = json.as_str(value) else |_| { return Bad("provenance address field {key}") }
        return address_number(text)
    }
    if n < 0 { return Bad("negative provenance address") }
    n as u64
}

/// Parse unsigned decimal or hexadecimal addresses with checked accumulation.
pub fn address_number(text: str) -> u64 ! {Bad(str)} {
    let hex = text.starts_with("0x")
    let begin = if hex then 2 else 0
    let base: u64 = if hex then 16 else 10
    if begin == text.len { return Bad("empty address") }
    var value: u64 = 0
    for i in begin..text.len {
        let b = text.bytes()[i] as int
        let d = if b >= 48 && b <= 57 then b - 48 else if b >= 97 && b <= 102 then b - 87 else 99
        if d as u64 >= base || value > (18446744073709551615 - d as u64) / base {
            return Bad("invalid or overflowing address {text}")
        }
        value = value * base + d as u64
    }
    value
}
