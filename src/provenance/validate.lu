//! member: true

use binary
use elf
use std.json

/// A malformed manifest is a named input refusal, not a defaulted value.
pub fn field(v: json.Value, key: str) -> json.Value ! {Bad(str)} {
    json.get(v, key) else |_| { return Bad("provenance missing field {key}") }
}

/// Read an integer field, refusing missing or wrongly typed data.
pub fn integer(v: json.Value, key: str) -> int ! {Bad(str)} {
    json.as_int(field(v, key)?) else |_| { return Bad("provenance integer field {key}") }
}

/// Read a string field, refusing missing or wrongly typed data.
pub fn text(v: json.Value, key: str) -> str ! {Bad(str)} {
    json.as_str(field(v, key)?) else |_| { return Bad("provenance string field {key}") }
}

/// Read an array field, refusing missing or wrongly typed data.
pub fn array(v: json.Value, key: str) -> List[json.Value] ! {Bad(str)} {
    json.as_arr(field(v, key)?) else |_| { return Bad("provenance array field {key}") }
}

/// Read the embedded document. Call check first; parsing is not authentication.
pub fn document(f: binary.Input, image: elf.Image) -> json.Value ! {Bad(str)} {
    for sec in image.sections {
        if (str_from_utf8(elf.name(f, image, sec)?) else "") != ".wolf.link.manifest" { continue }
        let raw = binary.read(f, sec.off, sec.size)?
        return decode_document(raw)
    }
    Bad("missing provenance manifest")
}

fn hex_digit(c: byte) -> int ! {Bad(str)} {
    let n = c as int
    if n >= 48 && n <= 57 { return n - 48 }
    if n >= 97 && n <= 102 { return n - 87 }
    Bad("invalid provenance hex bytes")
}

/// Digest validation precedes these semantic checks: signed garbage is still garbage.
pub fn validate(f: binary.Input, image: elf.Image) -> () ! {Bad(str)} {
    let doc = document(f, image)?
    if text(doc, "format")? != "wolf.link.provenance.v1" { return Bad("unknown provenance format") }
    let coverage = text(doc, "coverage")?
    if coverage == "sections" { return }
    if coverage != "bytes-and-patches" { return Bad("unknown provenance coverage") }
    if integer(field(doc, "output")?, "bytes")? != f.size { return Bad("provenance output length") }
    for section in array(doc, "sections")? {
        let index = integer(section, "index")?
        if index <= 0 || index >= image.sections.len { return Bad("provenance section index") }
        let sec = copy image.sections[index]
        if address_field(section, "address")? != sec.addr ||
            address_field(section, "memory_end")? != sec.addr + sec.size as u64 {
            return Bad("provenance section address differs from ELF")
        }
    }
    let members = array(doc, "members")?
    let spans = array(doc, "ranges")?
    var cursor: int = 0
    for r in spans {
        let start = integer(r, "start")?
        let end = integer(r, "end")?
        if start != cursor || end <= start || end > f.size {
            return Bad("provenance gap, overlap or invalid range")
        }
        let member = integer(r, "member")?
        if text(r, "origin")? == "input" {
            if member < 0 || member >= members.len { return Bad("provenance range member") }
            let offset = integer(r, "input_offset")?
            let size = integer(members[member], "size")?
            if offset < 0 || offset > size || end - start > size - offset {
                return Bad("provenance input slice")
            }
        } else if member != -1 {
            return Bad("provenance generated range member")
        }
        cursor = end
    }
    if cursor != f.size { return Bad("provenance incomplete byte coverage") }
    let edges = array(doc, "pulls")?
    var selected = Map[int, bool]()
    for edge in edges {
        let object = integer(edge, "object")?
        let parent = integer(edge, "parent")?
        if object < 0 ||
            object >= members.len ||
            parent < -1 ||
            parent >= object ||
            (selected[object] else false) {
            return Bad("provenance invalid or cyclic extraction edge")
        }
        selected[object] = true
    }
    let changes = array(doc, "patches")?
    var retained: int = 0
    for sec in image.sections { if sec.kind == 4 { retained += sec.size / 24 } }
    if changes.len != retained { return Bad("provenance retained patch count mismatch") }
    var previous_index: int = -1
    for p in changes {
        let index = integer(p, "index")?
        if index <= previous_index { return Bad("provenance patch index order or duplicate") }
        previous_index = index
        let start = integer(p, "start")?
        let end = integer(p, "end")?
        if start < 0 || end <= start || end > f.size { return Bad("provenance patch range") }
        let after = text(p, "after")?
        let before = text(p, "before")?
        if after.len != 2 * (end - start) || before.len != after.len {
            return Bad("provenance patch length")
        }
        let bytes = binary.read(f, start, end - start)?
        for i in 0..bytes.len {
            let value = hex_digit(after.bytes()[2 * i])? * 16 + hex_digit(after.bytes()[2 * i + 1])?
            if value != bytes[i] as int { return Bad("provenance patch bytes differ") }
            let _hi = hex_digit(before.bytes()[2 * i])?
            let _lo = hex_digit(before.bytes()[2 * i + 1])?
        }
    }
}

/// Decimal u64 text avoids JSON's lossy floating number tier above INT64_MAX.
pub fn address_json(value: u64) -> str {
    if value <= 9223372036854775807 { return "{value}" }
    "\"{value}\""
}

/// Parse a full-width address, retaining legacy nonnegative integer fields.
pub fn address_field(v: json.Value, key: str) -> u64 ! {Bad(str)} {
    let value = field(v, key)?
    let n = json.as_int(value) else |_| {
        let text = json.as_str(value) else |_| { return Bad("provenance address field {key}") }
        return address_number(text)
    }
    if n < 0 { return Bad("negative provenance address") }
    n as u64
}

/// Parse unsigned decimal or hexadecimal addresses with checked accumulation.
pub fn address_number(text: str) -> u64 ! {Bad(str)} {
    let hex = text.starts_with("0x")
    let begin = if hex then 2 else 0
    let base: u64 = if hex then 16 else 10
    if begin == text.len { return Bad("empty address") }
    var value: u64 = 0
    for i in begin..text.len {
        let b = text.bytes()[i] as int
        let d = if b >= 48 && b <= 57 then b - 48 else if b >= 97 && b <= 102 then b - 87 else 99
        if d as u64 >= base || value > (18446744073709551615 - d as u64) / base {
            return Bad("invalid or overflowing address {text}")
        }
        value = value * base + d as u64
    }
    value
}
