//! member: true

use binary
use layout
use resolve
use script

fn span(
    mut bytes: List[byte],
    mark: int,
    start: int,
    end: int,
    reason: str,
    member: int,
    section: int,
    offset: int,
) {
    if start == end { return }
    if bytes.len != mark { emit(mut bytes, ",") }
    emit(
        mut bytes,
        "{{\"end\":{end},\"input_offset\":{offset},\"member\":{member},\"origin\":{binary.quote(reason.bytes())},\"section_index\":{section},\"start\":{start}}}",
    )
}

/// Cover every file byte exactly once, including generated metadata and alignment. `members`
/// is each output's atoms in offset order (members_by_offset).
pub fn ranges(
    mut bytes: List[byte],
    l: layout.Layout,
    s: resolve.State,
    total: int,
    members: List[List[int]],
) -> () ! {Bad(str)} {
    let mark = bytes.len
    span(mut bytes, mark, 0, 64, "elf-header", -1, 0, 0)
    let phend = 64 + (if l.kernel || l.tls_address != 0 then 4 else 3) * 56
    span(mut bytes, mark, 64, phend, "program-headers", -1, 0, 0)
    var cursor = phend
    var seen = List[bool]()
    for _ in 0..l.outputs.len { (mut seen).push(false) }
    loop {
        var next: int = 0
        for i in 1..l.outputs.len {
            if l.outputs[i].kind == 8 || l.outputs[i].size == 0 || seen[i] { continue }
            if next == 0 || l.outputs[i].fileoff < l.outputs[next].fileoff { next = i }
        }
        if next == 0 { break }
        seen[next] = true
        let fileoff = l.outputs[next].fileoff
        if fileoff < cursor { return Bad("provenance output sections overlap") }
        span(mut bytes, mark, cursor, fileoff, "padding", -1, 0, 0)
        cursor = fileoff
        for ai in members[next] {
            if l.atoms[ai].kind == 8 || l.atoms[ai].size == 0 { continue }
            let begin = fileoff + l.atoms[ai].offset
            if begin < cursor { return Bad("provenance input sections overlap") }
            span(mut bytes, mark, cursor, begin, "padding", -1, 0, 0)
            let o = l.atoms[ai].object
            let input_offset = s.objects[o].image.sections[l.atoms[ai].index].off
            span(
                mut bytes,
                mark,
                begin,
                begin + l.atoms[ai].size,
                "input",
                o,
                l.atoms[ai].index,
                input_offset,
            )
            cursor = begin + l.atoms[ai].size
        }
        span(
            mut bytes,
            mark,
            cursor,
            fileoff + l.outputs[next].size,
            l.outputs[next].name,
            -1,
            next,
            0,
        )
        cursor = fileoff + l.outputs[next].size
    }
    let shoff = total - l.outputs.len * 64
    if cursor > shoff { return Bad("provenance section table overlaps content") }
    span(mut bytes, mark, cursor, shoff, "padding", -1, 0, 0)
    span(mut bytes, mark, shoff, total, "section-headers", -1, 0, 0)
}

/// Each output's live atoms in offset order (stable: equal offsets keep atom order). Output
/// content and coverage both walk these.
pub fn members_by_offset(l: layout.Layout) -> List[List[int]] {
    var members = List[List[int]]()
    (mut members).reserve(l.outputs.len)
    for _ in 0..l.outputs.len { (mut members).push(List[int]()) }
    for ai in 1..l.atoms.len {
        if l.atoms[ai].live && l.atoms[ai].output > 0 && l.atoms[ai].output < l.outputs.len {
            (mut members[l.atoms[ai].output]).push(ai)
        }
    }
    for j in 0..members.len {
        let n = members[j].len
        for i in 1..n {
            var k = i
            while k > 0 && l.atoms[members[j][k]].offset < l.atoms[members[j][k - 1]].offset {
                let old = members[j][k - 1]
                members[j][k - 1] = members[j][k]
                members[j][k] = old
                k -= 1
            }
        }
    }
    members
}

// The patch rules, by number: a relocated field, a TLS call its transition consumed, the two TLS
// transitions to local exec, and a GOT-relative instruction.
fn rule_name(rule: int) -> str {
    if rule == 1 { return "TLS-call-consumed" }
    if rule == 2 { return "TLSGD-local-exec" }
    if rule == 3 { return "TLSLD-local-exec" }
    if rule == 4 { return "GOT-instruction" }
    "field"
}

/// Attribute object oi's retained relocations, including TLS call sites consumed by a
/// transition, after its atoms are relocated: `original` holds the bytes each patched atom had
/// before (from relocate.pristine) and `sites` the object's site index. Bytes are evidence, not an independent proof: the
/// differential decoder checks them. Rows go out in relocation order, object by object, as
/// they always have; a row that cannot be attributed marks the table failed.
pub fn attribute(
    mut table: Patches,
    l: layout.Layout,
    s: resolve.State,
    oi: int,
    original: List[List[byte]],
    sites: List[int],
) -> () ! {Bad(str)} {
    if table.failed { return }
    let lo = l.object_relocs[oi]
    let hi = l.object_relocs[oi + 1]
    if lo == hi { return }
    let first = l.object_atoms[oi]
    // The consumer of each TLS call site, by the site's last relocation (last write wins).
    var consumer = List[int]()
    (mut consumer).reserve(hi - lo)
    for _ in lo..hi { (mut consumer).push(-1) }
    for i in lo..hi {
        let r = copy l.relocs[i]
        if !l.atoms[r.atom].live { continue }
        var call: int = -1
        if r.kind == 19 { call = r.offset + 8 }
        if r.kind == 20 {
            let indirect = original[r.atom - first][r.offset + 4] == 255 as byte
            call = r.offset + (if indirect then 6 else 5)
        }
        if call < 0 { continue }
        let at = layout.site_lookup_range(l.relocs, lo, sites, r.atom, call)
        if at >= 0 { consumer[at - lo] = i }
    }
    for i in lo..hi {
        let r = copy l.relocs[i]
        let ai = r.atom
        if !l.atoms[ai].live { continue }
        let k = ai - first
        let oo = l.atoms[ai].output
        let here = layout.site_lookup_range(l.relocs, lo, sites, r.atom, r.offset)
        let owner = if here >= 0 then consumer[here - lo] else -1
        var begin = r.offset
        var width = if r.kind == 1 || r.kind == 17 || r.kind == 257 then 8 else 4
        var rule: int = 0
        if owner >= 0 {
            rule = 1
        } else if r.kind == 19 {
            begin -= 4
            width = 16
            rule = 2
        } else if r.kind == 20 {
            begin -= 3
            width = if original[k][r.offset + 4] == 255 as byte then 13 else 12
            rule = 3
        } else if r.kind == 42 || r.kind == 22 {
            begin -= 3
            width = 7
            rule = 4
        }
        if begin < 0 || begin + width > original[k].len {
            table.failed = true
            return
        }
        let id = layout.target(s, r.symbol)?
        let start = l.outputs[oo].fileoff + l.atoms[ai].offset + begin
        let after_id = pool_hex(mut table, l.atoms[ai].data, begin, width)
        let before_id = pool_hex(mut table, original[k], begin, width)
        if table.rule_ids[rule] < 0 {
            table.rule_ids[rule] = pool_text(mut table, rule_name(rule))
        }
        let rule_id = table.rule_ids[rule]
        if table.symbol_ids[id] < 0 {
            table.symbol_ids[id] = pool_text(mut table, quoted_name(s.symbols[id].name))
        }
        let symbol_id = table.symbol_ids[id]
        patches_row(
            mut table,
            r.addend,
            after_id,
            before_id,
            owner,
            width,
            i,
            l.atoms[ai].object,
            r.offset,
            rule_id,
            l.atoms[ai].index,
            start,
            symbol_id,
            s.symbols[id].object,
            s.symbols[id].index,
            r.kind,
        )
    }
}

fn origin(
    mut bytes: List[byte],
    mark: int,
    l: layout.Layout,
    s: resolve.State,
    id: int,
    name: str,
) -> () ! {Bad(str)} {
    let sym = copy s.symbols[id]
    let ai = layout.atom_for(l, s, id)
    if ai == 0 && sym.section != 65521 && sym.section != 65522 { return }
    if ai != 0 && !l.atoms[ai].live { return }
    let nobits = sym.section == 65522 || ai != 0 && l.atoms[ai].kind == 8
    var start: int = -1
    var end: int = -1
    if ai != 0 && !nobits {
        start = l.outputs[l.atoms[ai].output].fileoff + l.atoms[ai].offset + sym.value as int
        end = start + sym.size as int
    }
    let address = layout.address(l, s, id, false)?
    let alias = if name != sym.name then binary.quote(sym.name.bytes()) else "null"
    if bytes.len != mark { emit(mut bytes, ",") }
    emit(
        mut bytes,
        "{{\"address\":{address_json(address)},\"alias_of\":{alias},\"binding\":{sym.binding},\"file_end\":{end},\"file_start\":{start},\"member\":{sym.object},\"name\":{binary.quote(name.bytes())},\"nobits\":{nobits},\"section_index\":{sym.section},\"size\":{sym.size},\"symbol_index\":{sym.index},\"tls\":{sym.kind == 6}}}",
    )
}

/// Retained definitions and aliases, with file and TLS/NOBITS spaces explicit.
pub fn origins(mut bytes: List[byte], l: layout.Layout, s: resolve.State) -> () ! {Bad(str)} {
    let mark = bytes.len
    for id in 0..s.symbols.len {
        let sym = copy s.symbols[id]
        if sym.index == 0 || sym.section == 0 || sym.name.len == 0 { continue }
        if sym.binding != 0 && resolve.global(s, sym.name) != id { continue }
        origin(mut bytes, mark, l, s, id, sym.name)?
    }
    if l.kernel {
        for name in layout.kernel_symbols() {
            if bytes.len != mark { emit(mut bytes, ",") }
            let address = l.synthetics[name] else 0
            emit(
                mut bytes,
                "{{\"address\":{address_json(address)},\"alias_of\":null,\"binding\":1,\"file_end\":-1,\"file_start\":-1,\"member\":-1,\"name\":{binary.quote(name.bytes())},\"nobits\":false,\"section_index\":65521,\"size\":0,\"symbol_index\":0,\"tls\":false,\"origin\":\"script-symbol\"}}",
            )
        }
    }
    for name in s.alias_names {
        let target = s.aliases[name] else { return Bad("missing provenance alias") }
        let id = resolve.global(s, target)
        if id < 0 { return Bad("missing provenance alias target") }
        origin(mut bytes, mark, l, s, id, name)?
    }
}

/// NOBITS address ranges never claim file bytes; TLS has its own address space.
pub fn memory_ranges(mut bytes: List[byte], l: layout.Layout) {
    let mark = bytes.len
    for i in 1..l.outputs.len {
        if l.outputs[i].kind != 8 || l.outputs[i].size == 0 { continue }
        let address = l.outputs[i].address
        if bytes.len != mark { emit(mut bytes, ",") }
        emit(
            mut bytes,
            "{{\"end\":{address_json(address + l.outputs[i].size as u64)},\"section_index\":{i},\"start\":{address_json(address)},\"tls\":{l.outputs[i].flags & 1024 != 0}}}",
        )
    }
}

/// Explain absent selected-input sections, without claiming unselected archive members were read.
pub fn discards(mut out: List[byte], l: layout.Layout, s: resolve.State) {
    let mark = out.len
    for oi in 0..s.objects.len {
        for si in 1..s.objects[oi].image.sections.len {
            let sec = copy s.objects[oi].image.sections[si]
            let name = s.objects[oi].names[si]
            let ai = layout.location(l, oi, si)
            var reason = ""
            if l.kernel && script.discards(name) {
                reason = "script-DISCARD"
            } else if sec.flags & 2147483648 != 0 {
                reason = "SHF_EXCLUDE"
            } else if s.objects[oi].discarded[si] {
                reason = "duplicate-COMDAT"
            } else if ai != 0 && !l.atoms[ai].live {
                reason = "GC-unreachable"
            } else if sec.kind == 2 || sec.kind == 3 || sec.kind == 4 {
                reason = "regenerated-metadata"
            } else if sec.kind == 17 {
                reason = "consumed-group-metadata"
            } else if name == ".note.GNU-stack" {
                reason = "consumed-stack-policy"
            }
            if reason.len == 0 { continue }
            if out.len != mark { emit(mut out, ",") }
            emit(
                mut out,
                "{{\"member\":{oi},\"reason\":\"{reason}\",\"section_index\":{si},\"section_name\":{binary.quote(name.bytes())},\"size\":{sec.size}}}",
            )
        }
    }
}
